# OpenRouter routes all LLM calls for this repo (not direct OpenAI/Anthropic keys)
OPENROUTER_API_KEY=
DEFAULT_MODEL=openai/gpt-4.1

# Per-role overrides (optional) — each falls back to DEFAULT_MODEL
MODEL_SCOPE=
MODEL_RESEARCH=
MODEL_COMPRESS=
MODEL_SUMMARIZE=
MODEL_SUPERVISOR=
MODEL_REPORT=

# Web search (separate from the OpenRouter LLM swap)
TAVILY_API_KEY=

# Supervisor fan-out — kept conservative (was hardcoded 3 in the course, caused a 429)
MAX_CONCURRENT_RESEARCHERS=2
MAX_RESEARCHER_ITERATIONS=6

# Persistence
SQLITE_PATH=data/threads.db

# Google Drive export (POST /threads/{id}/export) — reuse patent-translation-app's OAuth client
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_BASE_PATH=deep_research_agents
